# Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Hugging Face Hub Credentials & Repositories
HF_TOKEN=hf_your_write_token_here
HF_DATASET_REPO=ankush0710/hdfc-llm-datasets
HF_MODEL_REPO=ankush0710/hdfc-llm-models
# Maximum time a model artifact upload may wait before the run is marked FAILED.
HF_UPLOAD_TIMEOUT_SECONDS=900

# Application Configuration
# Set ALLOW_ORIGIN to your frontend production URL (comma-separated for multiple)
ALLOW_ORIGIN=https://your-frontend.vercel.app
# Set to 'development' to enable /docs and /redoc endpoints
ENVIRONMENT=production
# NEVER set DEBUG=true in production — enables verbose SQL query logging
DEBUG=false

# JWT Secret Key — REQUIRED. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-64-char-hex-secret-here

# Initial System Admin Account
INITIAL_ADMIN_EMAIL=ankushkurvey053@gmail.com
INITIAL_ADMIN_PASSWORD=your_secure_password
INITIAL_ADMIN_NAME=Ankush Kurvey (System Admin)

# AI Runtime Settings
AI_DEVICE=auto
AI_DEFAULT_MODEL=qwen3_0_6b
AI_MAX_NEW_TOKENS=256
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_DO_SAMPLE=false
